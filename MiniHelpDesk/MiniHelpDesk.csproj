<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(HeadlessTests)' != 'true'">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Ten sam projekt i dokładnie te same źródła logiki/testów, bez drugiego csproj. -->
    <TargetFramework Condition="'$(HeadlessTests)' == 'true'">net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MiniHelpDesk</RootNamespace>
    <UseMaui Condition="'$(HeadlessTests)' != 'true'">true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Mini HelpDesk</ApplicationTitle>
    <ApplicationId>pl.edu.minihelpdesk</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(HeadlessTests)' != 'true'">
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#152239" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#152239" BaseSize="128,128" />
    <Compile Remove="Tests/ConsoleRunner.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(HeadlessTests)' == 'true'">
    <Compile Remove="App.xaml.cs;MauiProgram.cs;MainPage.xaml.cs;Platforms/**/*.cs" />
    <None Remove="Platforms/**" />
  </ItemGroup>
</Project>
