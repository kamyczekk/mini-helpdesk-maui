<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiniHelpDesk.App">
  <Application.Resources>
    <Color x:Key="Ink">#17253D</Color>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Ink}" /></Style>
    <Style TargetType="Button">
      <Setter Property="BackgroundColor" Value="#2357D6" />
      <Setter Property="TextColor" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="MinimumHeightRequest" Value="48" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontSize" Value="14" />
      <Style.Triggers><Trigger TargetType="Button" Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Entry"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="MinimumHeightRequest" Value="48" /></Style>
    <Style TargetType="Editor"><Setter Property="TextColor" Value="{StaticResource Ink}" /></Style>
    <Style TargetType="Picker"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="MinimumHeightRequest" Value="48" /></Style>
    <Style x:Key="FieldError" TargetType="Label"><Setter Property="TextColor" Value="#B42318" /><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="Secondary" TargetType="Button"><Setter Property="BackgroundColor" Value="#E8EEF9" /><Setter Property="TextColor" Value="#2357D6" /></Style>
  </Application.Resources>
</Application>
