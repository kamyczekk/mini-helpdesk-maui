<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiniHelpDesk.ViewModels"
             xmlns:core="clr-namespace:MiniHelpDesk.Core"
             x:Class="MiniHelpDesk.MainPage" x:DataType="vm:HelpDeskViewModel"
             Title="Mini HelpDesk" BackgroundColor="#F2F5FA" SafeAreaEdges="All">
  <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <VerticalStackLayout Spacing="3">
        <Label Text="MINI HELPDESK" FontSize="12" CharacterSpacing="2" TextColor="#2357D6" />
        <Label Text="Centrum zgłoszeń" FontSize="26" FontAttributes="Bold" />
      </VerticalStackLayout>
      <Button Grid.Column="1" Text="+ Nowe" Command="{Binding NewCommand}" SemanticProperties.Description="Dodaj nowe zgłoszenie" />
    </Grid>
    <Label Grid.Row="1" Text="{Binding Message}" FontSize="13" TextColor="#52637D" />
    <Grid x:Name="Workspace" Grid.Row="2" ColumnDefinitions="*,1.5*" ColumnSpacing="18">
      <Border x:Name="FormCard" BackgroundColor="White" Stroke="#DCE4F0" StrokeShape="RoundRectangle 18" Padding="18">
        <ScrollView>
          <VerticalStackLayout Spacing="8">
            <Label Text="{Binding FormTitle}" FontSize="21" FontAttributes="Bold" Margin="0,0,0,6" />
            <Label Text="Nazwa" FontAttributes="Bold" FontSize="13" />
            <Entry Text="{Binding Name}" Placeholder="Np. Brak dostępu do drukarki" SemanticProperties.Description="Nazwa, co najmniej 3 znaki" />
            <Label Text="{Binding NameError}" Style="{StaticResource FieldError}" />
            <Label Text="Opis" FontAttributes="Bold" FontSize="13" />
            <Editor Text="{Binding Description}" Placeholder="Opisz problem i okoliczności jego wystąpienia…" HeightRequest="105" AutoSize="TextChanges" SemanticProperties.Description="Opis, co najmniej 10 znaków" />
            <Label Text="{Binding DescriptionError}" Style="{StaticResource FieldError}" />
            <Label Text="Priorytet" FontAttributes="Bold" FontSize="13" />
            <Picker Title="Wybierz priorytet" ItemsSource="{Binding Priorities}" SelectedIndex="{Binding PriorityIndex}" />
            <Label Text="{Binding PriorityError}" Style="{StaticResource FieldError}" />
            <Button Text="{Binding SaveLabel}" Command="{Binding SaveCommand}" Margin="0,6,0,0" />
            <Button Text="Anuluj / wróć do listy" Command="{Binding CancelCommand}" Style="{StaticResource Secondary}" />
            <VerticalStackLayout IsVisible="{Binding IsEditing}" Spacing="8" Margin="0,12,0,0">
              <BoxView HeightRequest="1" Color="#E1E7F0" />
              <Label Text="Status — osobna operacja" FontAttributes="Bold" />
              <Picker Title="Status" ItemsSource="{Binding Statuses}" SelectedIndex="{Binding StatusIndex}" />
              <Button Text="Zastosuj status" Command="{Binding StatusCommand}" Style="{StaticResource Secondary}" />
              <Button Text="Usuń zgłoszenie" Clicked="OnDeleteClicked" BackgroundColor="#FDE9E7" TextColor="#B42318" />
            </VerticalStackLayout>
          </VerticalStackLayout>
        </ScrollView>
      </Border>
      <Grid x:Name="ListPanel" Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Label Text="{Binding CountLabel}" FontSize="13" FontAttributes="Bold" CharacterSpacing="1" />
        <Label Grid.Row="1" Text="Wybierz zgłoszenie, aby edytować dane lub status." FontSize="12" TextColor="#52637D" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Tickets}" SelectionMode="Single" SelectedItem="{Binding SelectedTicket, Mode=TwoWay}">
          <CollectionView.EmptyView>
            <VerticalStackLayout Padding="24" Spacing="10" VerticalOptions="Center">
              <Label Text="Wszystko pod kontrolą" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
              <Label Text="Nie ma jeszcze zgłoszeń. Użyj przycisku + Nowe, aby dodać pierwsze." HorizontalTextAlignment="Center" TextColor="#52637D" />
            </VerticalStackLayout>
          </CollectionView.EmptyView>
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="core:Ticket">
              <Border Padding="16" Margin="0,0,0,10" BackgroundColor="White" Stroke="#DCE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding ShortId}" FontSize="11" TextColor="#718199" />
                  </Grid>
                  <Label Text="{Binding Description}" MaxLines="3" LineBreakMode="TailTruncation" TextColor="#52637D" />
                  <HorizontalStackLayout Spacing="8">
                    <Border BackgroundColor="#E8EEF9" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="9,5"><Label Text="{Binding PriorityLabel}" FontSize="12" TextColor="#2357D6" /></Border>
                    <Border BackgroundColor="#E6F5ED" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="9,5"><Label Text="{Binding StatusLabel}" FontSize="12" TextColor="#167246" /></Border>
                  </HorizontalStackLayout>
                </VerticalStackLayout>
              </Border>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
      </Grid>
    </Grid>
    <Button Grid.Row="3" Text="Uruchom testy logiki (MSTest)" Clicked="OnTestsClicked" Style="{StaticResource Secondary}" HorizontalOptions="Start" />
  </Grid>
</ContentPage>
